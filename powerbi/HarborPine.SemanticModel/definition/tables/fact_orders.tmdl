	partition fact_orders = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_orders.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"order_id", type text}, {"customer_id", type text}, {"order_date", type date}, {"order_status", type text}, {"carrier", type text}, {"payment_type", type text}, {"order_total", type number}, {"shipping_fee", type number}, {"items_revenue", type number}, {"items_margin", type number}, {"items_count", Int64.Type}, {"max_discount_pct", Int64.Type}, {"delivery_days", type number}, {"delay_days", Int64.Type}, {"delivery_band", type text}, {"delivery_band_order", Int64.Type}, {"review_score", Int64.Type}, {"customer_order_number", Int64.Type}}, "en-US"),
				    Logicals = Table.TransformColumns(Typed, {{"is_late", each if _ = null then null else _ = "True", type logical}, {"is_first_order", each if _ = null then null else _ = "True", type logical}, {"customer_has_repeat", each if _ = null then null else _ = "True", type logical}, {"payment_mismatch", each if _ = null then null else _ = "True", type logical}})
				in
				    Logicals

	annotation PBI_ResultType = Table
