table fact_orders
	lineageTag: fb97b297-64da-585b-9dad-0e9a6dbd8fc7

	measure Revenue = CALCULATE ( SUM ( fact_orders[order_total] ), fact_orders[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: 52aa227e-db4a-5ce9-96d7-e5803ae551a3

	measure Orders = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: b30d2f25-aa74-534c-a5e3-4155475001d2

	measure Customers = CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_id] ), fact_orders[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: f537f784-b753-5daf-838f-b40703ef8e20

	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: Sales
		lineageTag: 01a11e48-db1b-5859-93b9-21a5293864bf

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Sales
		lineageTag: 29b29d46-31f2-5b93-924f-87e60c7dbaa8

	measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Sales
		lineageTag: de79155e-2f5e-5ada-a854-d75772a74ac6

	measure 'Canceled Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "canceled" )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 707f2ae4-810d-5ee5-ab39-60407e1b0402

	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( fact_orders[customer_id] ), [Orders] > 1 ) )
		formatString: #,0
		displayFolder: Customers
		lineageTag: f5735121-1e89-52b9-82ac-490f69fa5395

	measure 'Repeat Rate %' = DIVIDE ( [Repeat Customers], [Customers] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customers
		lineageTag: 7ec73915-151c-5eb8-9117-c203b4e8eccb

	measure 'Came Back %' = VAR FirstOrders = CALCULATETABLE ( fact_orders, fact_orders[is_first_order] = TRUE (), fact_orders[order_status] = "delivered", fact_orders[order_date] < DATE ( 2025, 7, 1 ) ) RETURN DIVIDE ( COUNTROWS ( FILTER ( FirstOrders, fact_orders[customer_has_repeat] = TRUE () ) ), COUNTROWS ( FirstOrders ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Customers
		lineageTag: 4ea45c98-d694-560d-bf04-90248765964a

	measure 'Delivered Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "delivered" )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 113923ee-2b5e-5616-8413-97c957ab0f64

	measure 'Late Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: aa84b383-b90e-5f16-a34a-8fda3f335c4f

	measure 'Late Rate %' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: 447d2d91-ec2e-5777-8e5c-5fbb69874d59

	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[order_status] = "delivered" )
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: 10bf1d20-aa20-5da7-b4c5-82336cdb0b30

	measure 'Avg Review Score' = AVERAGE ( fact_orders[review_score] )
		formatString: #,0.00
		displayFolder: Reviews
		lineageTag: df1fa8f1-51e4-5f99-b0d1-711efc2e1071

	measure 'Low Reviews %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] <= 2, NOT ISBLANK ( fact_orders[review_score] ) ), CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Reviews
		lineageTag: 50394b09-8e1b-5f6a-a3d7-49d6b9796a59

	measure 'Payment Mismatches' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[payment_mismatch] = TRUE () )
		formatString: #,0
		displayFolder: Finance
		lineageTag: 0492f7bf-9094-5fb5-b55d-cd75a6a91d2b

	measure 'Review Color' = SWITCH ( TRUE (), [Avg Review Score] < 3, "#C0392B", [Avg Review Score] < 4, "#E67E22", "#2563EB" )
		displayFolder: Formatting
		lineageTag: 82a06d90-9001-5551-9a7e-01310c53120b

	measure 'Came Back Color' = SWITCH ( TRUE (), [Came Back %] < 0.15, "#C0392B", [Came Back %] < 0.27, "#E67E22", "#2563EB" )
		displayFolder: Formatting
		lineageTag: add5f915-3ec8-56f2-8860-327e4309fe7a

	measure 'Late Color' = SWITCH ( TRUE (), [Late Rate %] >= 0.2, "#C0392B", [Late Rate %] >= 0.12, "#E67E22", "#2563EB" )
		displayFolder: Formatting
		lineageTag: 8135abb0-7460-551b-9d2e-93519c173b47

