table fact_order_items
	lineageTag: 7e23b716-caf4-5aab-af17-69fa7110c4fe

	measure 'Item Revenue' = CALCULATE ( SUM ( fact_order_items[line_revenue] ), fact_order_items[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Products
		lineageTag: faa24e89-5b77-5d14-bc57-37b9a24e878e

	measure 'Gross Margin' = CALCULATE ( SUM ( fact_order_items[line_margin] ), fact_order_items[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: Products
		lineageTag: 5ee0e73d-65b4-53a2-8dad-7732b52f4f26

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Item Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Products
		lineageTag: 45254f17-68fe-5d49-95d7-7765e03ab61f

	measure 'Units Sold' = CALCULATE ( SUM ( fact_order_items[quantity] ), fact_order_items[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: Products
		lineageTag: 3b0f8d05-5745-5d1c-8d8b-95c9fe5ef47c

	measure 'Margin Color' = SWITCH ( TRUE (), [Gross Margin %] < 0.4, "#C0392B", [Gross Margin %] < 0.47, "#E67E22", "#2563EB" )
		displayFolder: Formatting
		lineageTag: fb81f4b3-3c60-5443-ba03-c24521db0b52

