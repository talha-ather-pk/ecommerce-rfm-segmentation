table customer_rfm
	lineageTag: f9b55ee3-d8e3-5e0e-9c74-a6cee4623e91

	measure 'Scored Customers' = COUNTROWS ( customer_rfm )
		formatString: #,0
		displayFolder: RFM
		lineageTag: 955338f0-6c7c-55e8-9c26-15ce137655db

	measure 'Lifetime Revenue' = SUM ( customer_rfm[monetary] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: RFM
		lineageTag: 38543580-7a1c-5a18-bf69-6494a8ddadca

	measure '% of Customers' = DIVIDE ( [Scored Customers], CALCULATE ( [Scored Customers], ALL ( customer_rfm ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: RFM
		lineageTag: c0f13afe-9c05-5dd3-b99a-fbca1c58ab2c

	measure '% of Revenue' = DIVIDE ( [Lifetime Revenue], CALCULATE ( [Lifetime Revenue], ALL ( customer_rfm ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: RFM
		lineageTag: 80cf3f3b-7395-5e48-af0e-ef260ad46349

	measure 'Avg Recency Days' = AVERAGE ( customer_rfm[recency_days] )
		formatString: #,0
		displayFolder: RFM
		lineageTag: f479e686-83c9-5fcd-8f9d-736763b8f53a

	measure 'Avg Orders per Customer' = AVERAGE ( customer_rfm[frequency] )
		formatString: #,0.00
		displayFolder: RFM
		lineageTag: a8db3324-e3c5-5013-b4e2-3b9b82579a1d

	measure 'Avg Lifetime Spend' = DIVIDE ( [Lifetime Revenue], [Scored Customers] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: RFM
		lineageTag: eec2b95b-3b81-5eb2-842d-4b2733ef28cd

	measure 'Top Segments Revenue Share' = CALCULATE ( [% of Revenue], customer_rfm[segment] IN { "Champions", "Loyal" } )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: RFM
		lineageTag: acf24c10-beb2-5e0b-a42b-a85dffd66e4f

