	partition dim_customer = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_customer.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.TransformColumns(Promoted, {}, each if _ = "" then null else _),
				    Typed = Table.TransformColumnTypes(Blanks, {{"customer_id", type text}, {"city", type text}, {"state_code", type text}, {"state_name", type text}, {"region", type text}, {"acquisition_channel", type text}, {"signup_date", type date}}, "en-US"),
				    Joined = Table.NestedJoin(Typed, {"customer_id"}, RFM_Staging, {"customer_id"}, "rfm", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "rfm", {"recency_days", "frequency", "monetary", "r_score", "f_score", "m_score", "rfm_code", "segment_order", "segment"}),
				    Retyped = Table.TransformColumnTypes(Expanded, {{"recency_days", Int64.Type}, {"frequency", Int64.Type}, {"monetary", type number}, {"r_score", Int64.Type}, {"f_score", Int64.Type}, {"m_score", Int64.Type}, {"rfm_code", type text}, {"segment_order", Int64.Type}, {"segment", type text}}),
				    NoOrder = Table.ReplaceValue(Retyped, null, "No completed order", Replacer.ReplaceValue, {"segment"}),
				    NoOrderSort = Table.ReplaceValue(NoOrder, null, 9, Replacer.ReplaceValue, {"segment_order"})
				in
				    NoOrderSort

	annotation PBI_ResultType = Table
