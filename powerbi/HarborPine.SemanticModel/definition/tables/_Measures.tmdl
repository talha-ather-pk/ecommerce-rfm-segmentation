	measure 'Review Color' = SWITCH ( TRUE (), ISBLANK ( [Avg Review Score] ), "#94A3B8", [Avg Review Score] < 3, "#B5523B", [Avg Review Score] < 4, "#D08C2E", "#0E7C86" )
