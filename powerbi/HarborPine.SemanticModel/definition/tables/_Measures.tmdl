table _Measures
	lineageTag: 0f54fd1b-9e1d-5ff9-b098-aa783e7b8ba3

	measure Revenue = CALCULATE ( SUM ( fact_orders[order_total] ), fact_orders[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 21f885b0-6a64-5376-8384-6d290e6f6dd0

	measure Orders = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 854e1c7f-3de8-544e-b4f9-99d6ded2ad03

	measure Customers = CALCULATE ( DISTINCTCOUNT ( fact_orders[customer_id] ), fact_orders[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: ad683f85-02d0-55af-ae28-4967a589b528

	measure 'Avg Order Value' = DIVIDE ( [Revenue], [Orders] )
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		displayFolder: 1 Sales
		lineageTag: 1a0df751-d4a8-58ba-b438-0623ca2ba101

	measure 'Canceled Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "canceled" )
		formatString: #,0
		displayFolder: 1 Sales
		lineageTag: 095f3382-c3eb-5ad1-9206-e64134c07083

	measure 'Revenue PY' = CALCULATE ( [Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: 65533b53-5c0c-59b3-b3ca-fe1dc572f2a5

	measure 'Revenue YoY %' = DIVIDE ( [Revenue] - [Revenue PY], [Revenue PY] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales
		lineageTag: 4a7a1b64-e1dd-5cab-9ed9-7234c63ec020

	measure 'Revenue YTD' = TOTALYTD ( [Revenue], dim_date[date] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: ad7b5bc8-8b29-5f3a-bd00-eee0d4226854

	measure 'Revenue Rolling 3M' = CALCULATE ( [Revenue], DATESINPERIOD ( dim_date[date], MAX ( dim_date[date] ), -3, MONTH ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 1 Sales
		lineageTag: bd4e506d-a22f-5ffc-b093-7b5650c502a2

	measure 'Revenue Share of Total' = DIVIDE ( [Revenue], CALCULATE ( [Revenue], REMOVEFILTERS ( dim_customer[region] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 1 Sales
		lineageTag: 9705d82b-db1d-51b5-9fd9-6040f413207c

	measure 'Repeat Customers' = COUNTROWS ( FILTER ( VALUES ( fact_orders[customer_id] ), [Orders] > 1 ) )
		formatString: #,0
		displayFolder: 2 Customers
		lineageTag: 542018ef-9c4c-57ca-80c8-a4a621c0d3f8

	measure 'Repeat Rate %' = DIVIDE ( [Repeat Customers], [Customers] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Customers
		lineageTag: 973906ff-53ff-552c-a86f-5ff054c386d4

	measure 'Came Back %' = VAR FirstOrders = CALCULATETABLE ( fact_orders, fact_orders[is_first_order] = TRUE (), fact_orders[order_status] = "delivered", fact_orders[order_date] < DATE ( 2025, 7, 1 ) ) RETURN DIVIDE ( COUNTROWS ( FILTER ( FirstOrders, fact_orders[customer_has_repeat] = TRUE () ) ), COUNTROWS ( FirstOrders ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 2 Customers
		lineageTag: 7e49f5a3-4bbc-526a-ab01-5785cd5b157e

	measure 'Scored Customers' = CALCULATE ( COUNTROWS ( dim_customer ), dim_customer[segment_order] <= 8 )
		formatString: #,0
		displayFolder: 3 RFM
		lineageTag: e4a29708-a1e4-5691-ba85-965c97810547

	measure 'Lifetime Revenue' = CALCULATE ( SUM ( dim_customer[monetary] ), dim_customer[segment_order] <= 8 )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 RFM
		lineageTag: ee8b7c4b-96e7-58ea-8493-88492796c678

	measure '% of Customers' = DIVIDE ( [Scored Customers], CALCULATE ( [Scored Customers], REMOVEFILTERS ( dim_customer[segment], dim_customer[segment_order] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 RFM
		lineageTag: b4f0a242-271e-5a6f-82ee-d5fb1d1a7e48

	measure '% of Revenue' = DIVIDE ( [Lifetime Revenue], CALCULATE ( [Lifetime Revenue], REMOVEFILTERS ( dim_customer[segment], dim_customer[segment_order] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 RFM
		lineageTag: ab960922-8bc4-5a1d-be75-1d5c39cff605

	measure 'Avg Recency Days' = CALCULATE ( AVERAGE ( dim_customer[recency_days] ), dim_customer[segment_order] <= 8 )
		formatString: #,0
		displayFolder: 3 RFM
		lineageTag: c8015745-84b1-5afb-922f-01a86b676a2e

	measure 'Avg Orders per Customer' = CALCULATE ( AVERAGE ( dim_customer[frequency] ), dim_customer[segment_order] <= 8 )
		formatString: #,0.00
		displayFolder: 3 RFM
		lineageTag: e127d221-7d9d-542f-baf2-678cff8c3575

	measure 'Avg Lifetime Spend' = DIVIDE ( [Lifetime Revenue], [Scored Customers] )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 3 RFM
		lineageTag: aad1de7e-c503-50c8-9bdb-0adf8965e017

	measure 'Top Segments Revenue Share' = CALCULATE ( [% of Revenue], dim_customer[segment] IN { "Champions", "Loyal" } )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 RFM
		lineageTag: 2733bed4-1b29-577d-9025-9537200b2a9e

	measure 'Delivered Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "delivered" )
		formatString: #,0
		displayFolder: 4 Delivery
		lineageTag: 56defc80-f76a-542e-9f00-8e405ff67c09

	measure 'Late Orders' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[order_status] = "delivered", fact_orders[is_late] = TRUE () )
		formatString: #,0
		displayFolder: 4 Delivery
		lineageTag: 5e6809d1-8144-584e-8b33-fc649f69dffe

	measure 'Late Rate %' = DIVIDE ( [Late Orders], [Delivered Orders] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Delivery
		lineageTag: d74ade52-30fe-546b-9dcb-315dd1fbf6a5

	measure 'Avg Delivery Days' = CALCULATE ( AVERAGE ( fact_orders[delivery_days] ), fact_orders[order_status] = "delivered" )
		formatString: #,0.0
		displayFolder: 4 Delivery
		lineageTag: 42ba2b5e-a7d2-5e66-93c6-1633d35a91c7

	measure 'Avg Review Score' = AVERAGE ( fact_orders[review_score] )
		formatString: #,0.00
		displayFolder: 4 Delivery
		lineageTag: 3bb9808b-f7ea-5507-9e82-5cbf0a7236c1

	measure 'Low Reviews %' = DIVIDE ( CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[review_score] <= 2, NOT ISBLANK ( fact_orders[review_score] ) ), CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 4 Delivery
		lineageTag: 2ae5dc71-0d54-52fa-aced-acc3f928e082

	measure 'Payment Mismatches' = CALCULATE ( COUNTROWS ( fact_orders ), fact_orders[payment_mismatch] = TRUE () )
		formatString: #,0
		displayFolder: 4 Delivery
		lineageTag: dc813f23-93eb-5006-bc50-05243f0a8340

	measure 'Item Revenue' = CALCULATE ( SUM ( fact_order_items[line_revenue] ), fact_order_items[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Products
		lineageTag: ea12b70c-f6a0-5736-8173-c76e2c980d5d

	measure 'Gross Margin' = CALCULATE ( SUM ( fact_order_items[line_margin] ), fact_order_items[order_status] <> "canceled" )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Products
		lineageTag: 5df33f04-0fd0-5f21-9019-a1cfaa459bfc

	measure 'Gross Margin %' = DIVIDE ( [Gross Margin], [Item Revenue] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Products
		lineageTag: 2ac58614-c629-5237-a485-4bb41e7b3117

	measure 'Units Sold' = CALCULATE ( SUM ( fact_order_items[quantity] ), fact_order_items[order_status] <> "canceled" )
		formatString: #,0
		displayFolder: 5 Products
		lineageTag: f6309313-5778-5738-ae77-4caad37198d5

	measure 'Item Revenue PY' = CALCULATE ( [Item Revenue], SAMEPERIODLASTYEAR ( dim_date[date] ) )
		formatString: \$#,0;(\$#,0);\$#,0
		displayFolder: 5 Products
		lineageTag: 18db1176-6c0a-5ea3-ac8d-1381b0b868a8

	measure 'Category Revenue Share' = DIVIDE ( [Item Revenue], CALCULATE ( [Item Revenue], REMOVEFILTERS ( dim_product ) ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 5 Products
		lineageTag: 5b418aa5-5c28-5afc-b984-b4e939248dc3

	measure 'Product Rank' = IF ( ISINSCOPE ( dim_product[product_name] ), RANKX ( ALLSELECTED ( dim_product[product_name], dim_product[category] ), [Item Revenue], , DESC, DENSE ) )
		formatString: #,0
		displayFolder: 5 Products
		lineageTag: 7d31507c-b0d8-5d65-8b0b-331eec9e9154

	measure 'Selected Year' = MAX ( dim_date[year] )
		formatString: 0
		isHidden
		displayFolder: 9 Helpers
		lineageTag: 74f275d3-4e79-5836-8cde-4778a97a154e

	measure 'Revenue (Latest Year)' = VAR y = [Selected Year] RETURN CALCULATE ( [Revenue], REMOVEFILTERS ( dim_date ), dim_date[year] = y )
		isHidden
		displayFolder: 6 Year over year
		lineageTag: f6883243-2f64-5926-bc32-3e06ad3c9c4c

	measure 'Revenue (Prior Year)' = VAR y = [Selected Year] - 1 RETURN CALCULATE ( [Revenue], REMOVEFILTERS ( dim_date ), dim_date[year] = y )
		isHidden
		displayFolder: 6 Year over year
		lineageTag: 8b6d3cb2-e8a5-53d1-9442-a0fcc9833ecb

	measure 'Revenue vs PY' = DIVIDE ( [Revenue (Latest Year)] - [Revenue (Prior Year)], [Revenue (Prior Year)] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 6 Year over year
		lineageTag: 1a02d030-6945-5dac-804c-53f650d70937

	measure 'Revenue vs PY Label' = IF ( ISBLANK ( [Revenue (Prior Year)] ) || ISBLANK ( [Revenue (Latest Year)] ), "No prior year to compare", FORMAT ( [Revenue vs PY], "▲ 0.0%;▼ 0.0%;● 0.0%" ) & "   " & [Selected Year] & " vs " & ( [Selected Year] - 1 ) )
		displayFolder: 6 Year over year
		lineageTag: 09b40d98-67da-5ca2-848f-27c9fdd50d99

	measure 'Revenue vs PY Color' = IF ( ISBLANK ( [Revenue (Prior Year)] ) || ISBLANK ( [Revenue (Latest Year)] ), "#94A3B8", IF ( [Revenue vs PY] >= 0, "#0E7C86", "#B5523B" ) )
		isHidden
		displayFolder: 8 Formatting
		lineageTag: fde6a873-9690-54b6-af99-8557a9c094c7

