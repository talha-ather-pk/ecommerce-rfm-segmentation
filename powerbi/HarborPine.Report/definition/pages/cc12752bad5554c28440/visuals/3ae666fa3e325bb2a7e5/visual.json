          "properties": {
            "paragraphs": [
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "KEY INSIGHTS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#C8A24A",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "   ·   all data, 2023 – 2025",
                    "textStyle": {
                      "fontSize": "8pt",
                      "color": "#94A3B8",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Growth is volume-led. ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Revenue rose 55% in 2024 and 32% in 2025 while the average order stayed near $105.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#CBD5E1",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "A quarter of customers return. ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "25% order again, 60% of them within 90 days of their first order.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#CBD5E1",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Value is concentrated. ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Champions + Loyal are 7.9% of customers but 24.7% of revenue.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#CBD5E1",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Late first orders lose customers. ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Only 7.1% return after a first order 4+ days late, vs 31.1% when on time.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#CBD5E1",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              },
              {
                "horizontalTextAlignment": "left",
                "textRuns": [
                  {
                    "value": "Economy shipping is the weak link. ",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#FFFFFF",
                      "fontFamily": "Segoe UI Semibold",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": "Late 23.5% of the time vs 11.3% for Standard.",
                    "textStyle": {
                      "fontSize": "9.5pt",
                      "color": "#CBD5E1",
                      "fontFamily": "Segoe UI"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
